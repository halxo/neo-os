#!/usr/bin/env bash
set -euo pipefail

# Build the NeoOS Gentoo OpenRC Graphical Live ISO using cached Docker layers.
REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: docker is required to build the NeoOS Gentoo Live ISO." >&2
    exit 1
fi

echo "==> Building/updating neoos-gentoo-live:latest base image..."
docker build -f "${REPO_DIR}/gentoo/Dockerfile.live" -t neoos-gentoo-live:latest "${REPO_DIR}"

echo "==> Packing NeoOS Gentoo OpenRC Graphical Live ISO..."
docker run --rm --privileged \
    -e HOST_UID="$(id -u)" \
    -e HOST_GID="$(id -g)" \
    -v "${REPO_DIR}:/workspace" \
    neoos-gentoo-live:latest \
    bash /workspace/gentoo/pack-iso.sh /workspace
