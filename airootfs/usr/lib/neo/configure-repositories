#!/bin/bash
set -euo pipefail

# --root allows configuring an installation tree without changing the live host.
ROOT=""
if [[ "${1:-}" == --root ]]; then
    [[ $# -ge 3 && "$2" == /* ]] || { echo "--root requires an absolute path" >&2; exit 1; }
    ROOT="${2%/}"
    shift 2
fi
MODE="${1:-status}"
CONFIG="$ROOT/etc/pacman.d/neo-repositories.conf"
MODE_FILE="$ROOT/etc/neo/repository-mode.conf"

detect_cpu_level() {
    local loader info
    for loader in /usr/lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2; do
        [[ -x "$loader" ]] || continue
        info="$("$loader" --help 2>/dev/null || true)"
        for level in v4 v3 v2; do
            if grep -q "x86-64-$level (supported" <<< "$info"; then
                echo "x86-64-$level"
                return
            fi
        done
    done
    echo x86-64
}
CPU_LEVEL="$(detect_cpu_level)"

neoos_repo() {
    printf '[neoos]
SigLevel = Optional TrustAll
Server = https://halxo.github.io/neo-os/repo/$arch

'
}

arch_repos() {
    for repo in core extra multilib; do
        printf '[%s]\nInclude = /etc/pacman.d/mirrorlist\n\n' "$repo"
    done
}
cachyos_repos() {
    # The generic CachyOS repository is the fallback on older CPUs.
    if [[ "$CPU_LEVEL" == x86-64-v3 || "$CPU_LEVEL" == x86-64-v4 ]]; then
        local level="${CPU_LEVEL##*-}"
        for repo in "cachyos-$level" "cachyos-core-$level" "cachyos-extra-$level"; do
            printf '[%s]\nInclude = /etc/pacman.d/cachyos-%s-mirrorlist\n\n' "$repo" "$level"
        done
    fi
    printf '[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n\n'
}
render() {
    echo '# Generated by NeoOS; use neo repos arch or neo repos cachyos.'
    # Keep x86_64 first: pacman expands $arch in mirror URLs from this value.
    # Accept only instruction sets supported by this CPU, in either repo mode.
    printf '[options]\nArchitecture = x86_64'
    case "$CPU_LEVEL" in
        x86-64-v4) printf ' x86_64_v2 x86_64_v3 x86_64_v4' ;;
        x86-64-v3) printf ' x86_64_v2 x86_64_v3' ;;
        x86-64-v2) printf ' x86_64_v2' ;;
    esac
    printf '\n\n' 
    neoos_repo
    if [[ "$MODE" == arch ]]; then
        arch_repos
        # Keep the live ISO and Arch-first installs on baseline Arch packages.
        printf '[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n'
    else
        cachyos_repos
        arch_repos
    fi
}

case "$MODE" in
    status)
        saved=arch
        [[ ! -f "$MODE_FILE" ]] || saved="$(sed -n 's/^mode=//p' "$MODE_FILE" | head -n1)"
        echo "Repository mode: $saved"
        echo "CPU optimization: $CPU_LEVEL"
        optimized=none
        if [[ "$saved" == cachyos && ( "$CPU_LEVEL" == x86-64-v3 || "$CPU_LEVEL" == x86-64-v4 ) ]]; then
            optimized="cachyos-${CPU_LEVEL##*-}"
        fi
        echo "Optimized repository: $optimized"
        echo
        echo 'Active repositories:'
        [[ ! -f "$CONFIG" ]] || sed -n '/^\[options\]$/d; s/^\[\(.*\)\]$/\1/p' "$CONFIG"
        exit 0 ;;
    list)
        sed -n '/^\[options\]$/d; s/^\[\(.*\)\]$/\1/p' "$CONFIG"
        exit 0 ;;
    arch|cachyos) ;;
    *) echo 'Usage: configure-repositories [--root PATH] {status|list|arch|cachyos} [--print]' >&2; exit 1 ;;
esac
if [[ "${2:-}" == --print ]]; then
    render
    exit 0
fi
[[ $# -le 1 ]] || { echo 'Unexpected argument' >&2; exit 1; }
if [[ -z "$ROOT" && $EUID -ne 0 ]]; then
    echo 'Run with sudo to change repository priority.' >&2
    exit 1
fi
mkdir -p "$ROOT/etc/pacman.d" "$ROOT/etc/neo"
# Serialize switches and replace complete files, never a partially written config.
exec 9>"$ROOT/etc/neo/repository-mode.lock"
flock 9
repo_tmp="$(mktemp "$CONFIG.XXXXXX")"
mode_tmp="$(mktemp "$MODE_FILE.XXXXXX")"
trap 'rm -f "$repo_tmp" "$mode_tmp"' EXIT
render > "$repo_tmp"
printf 'mode=%s\n' "$MODE" > "$mode_tmp"
chmod 644 "$repo_tmp" "$mode_tmp"
mv -f "$repo_tmp" "$CONFIG"
mv -f "$mode_tmp" "$MODE_FILE"
echo "NeoOS repository priority: $MODE"
echo 'Run sudo pacman -Syu before installing packages.'
