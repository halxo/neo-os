      "display_manager": "gdm",
      "use_flags": ["elogind", "dbus", "wayland", "X", "pulseaudio", "pipewire", "networkmanager", "gnome", "gtk"],
      "packages": [
        "gnome-base/gnome-light",
        "x11-terms/gnome-terminal",
