{
  "desktops": [
    {
      "id": "kde",
      "name": "KDE Plasma",
      "category": "Full Desktop",
      "description": "Feature-rich, customizable modern desktop powered by Qt (Wayland & X11).",
      "profile": "default/linux/amd64/23.0/desktop/plasma",
      "display_manager": "sddm",
      "use_flags": ["elogind", "dbus", "wayland", "X", "pulseaudio", "pipewire", "networkmanager", "kde", "qt6"],
      "packages": [
        "kde-plasma/plasma-meta",
        "kde-apps/konsole",
        "kde-apps/dolphin",
        "kde-apps/kate",
        "gui-apps/sddm",
        "gui-libs/display-manager-init"
      ],
      "openrc_services": ["dbus", "elogind", "NetworkManager", "display-manager"]
    },
    {
      "id": "gnome",
      "name": "GNOME",
      "category": "Full Desktop",
